APP_NAME=Laravel
APP_ENV=testing   # 換成 testing
APP_KEY=          # 留空 CI 裡會用 artisan key:generate 自動生成
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite    # 換成 sqlite 跑 in-memory 測試
# DB_HOST=127.0.0.1
# DB_PORT=3306
DB_DATABASE=:memory:    # 測試 記憶體
# DB_USERNAME=allen
# DB_PASSWORD=evelynn9527

SESSION_DRIVER=array    # 測試用 array 存 session
# SESSION_LIFETIME=120
# SESSION_ENCRYPT=false
# SESSION_PATH=/
# SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync   # 測試 queue 不需要 Redis，改成 sync

CACHE_STORE=array       # 測試用 array 存 cache
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# REDIS_CLIENT=phpredis # 測試環境不用 redis 註解避免連線
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

MAIL_MAILER=log         # 測試 Mail 改成 log，避免寄信
MAIL_HOST=live.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=api
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@demomailtrap.co"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

INERTIA_SSR_ENABLED=false   # Inertia SSR 在測試環境可以關掉

GEMINI_TOKEN=

TEMPO_ENDPOINT=